                        <div class="py-2 text-xs font-bold ${slopeAdj !== 0 ? 'text-blue-500' : 'text-slate-400'}">${fmt(slopeAdj)}</div>
                    </div>

                    <div class="flex justify-between items-center w-full px-4 py-3 bg-slate-50/50 border-t border-slate-100">
                        <div class="text-center flex-1">
                            <span class="block text-[9px] text-slate-400 uppercase tracking-wider mb-0.5">Plays Like</span>
                            <span class="block text-xl font-bold text-slate-800">${totalPlaysLike}y</span>
                        </div>
                        <div class="h-8 w-px bg-slate-200 mx-4"></div>
                        <div class="text-center flex-1">
                            <span class="block text-[9px] text-slate-400 uppercase tracking-wider mb-0.5">Caddie Suggests</span>
                            <span class="block text-xl font-bold text-golf-600 leading-none">${rec.pct}% <span class="text-slate-700 text-base">${rec.club}</span></span>
                        </div>
                    </div>
                </div>
            `;
        }
    }

    // Listeners
    document.getElementById('hcp-input').addEventListener('input', e=>{
        window.state.hcp=parseInt(e.target.value);
        saveUserSetting('handicap', window.state.hcp);
        document.getElementById('hcp-val').textContent = window.state.hcp<0 ? "+"+Math.abs(window.state.hcp) : window.state.hcp;
        updateUI();
    });
    document.getElementById('dist-input').addEventListener('input', e=>{
        window.state.dist=e.target.value;
        window.state.manualDistance = true;
        document.getElementById('reset-dist-btn').classList.remove('hidden');
        document.getElementById('dist-val').textContent=window.state.dist;
        updateUI();
    });

    // Init
    updateLieButtons();
    updateUI();
</script>
</body>
</html>
