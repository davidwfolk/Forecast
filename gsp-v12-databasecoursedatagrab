    // --- NEW: SAVE MAP DATA TO SUPABASE ---
    async function saveCourseToSupabase(course, polygons) {
        if (!course || !course.id) return;
        
        // Check if course exists
        const { data: existing } = await supabase.from('courses').select('id').eq('osm_id', course.id.toString()).single();
        if (existing) { console.log("Course exists in DB."); return; }

        console.log("Saving New Course...");
        
        // Insert Course
        const { data: newCourse, error: courseErr } = await supabase.from('courses').insert({
            name: course.name,
            osm_id: course.id.toString(),
            location: `POINT(${course.lon} ${course.lat})`
        }).select().single();

        if (courseErr) { console.error("DB Error:", courseErr); return; }
        const courseId = newCourse.id;

        // Insert Holes
        const holeRows = course.holes.map(h => ({
            course_id: courseId,
            hole_number: h.sortRef || 0,
            par: parseInt(h.pars.default) || 4,
            green_center: `POINT(${h.lon} ${h.lat})`,
            tee_box: h.teeLocation ? `POINT(${h.teeLocation.lon} ${h.teeLocation.lat})` : null
        }));
        await supabase.from('holes').insert(holeRows);

        // Insert Polygons (filtered by distance)
        const distFn = window.calcDist || ((lat1,lon1,lat2,lon2) => {
             const R=6371e3, φ1=lat1*Math.PI/180, φ2=lat2*Math.PI/180, Δφ=(lat2-lat1)*Math.PI/180, Δλ=(lon2-lon1)*Math.PI/180;
             const a=Math.sin(Δφ/2)**2 + Math.cos(φ1)*Math.cos(φ2)*Math.sin(Δλ/2)**2;
             return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))*1.09361;
        });

        const relevantPolys = polygons.filter(p => {
            return distFn(course.lat, course.lon, p.points[0].lat, p.points[0].lon) < 2500; 
        });

        const featureRows = relevantPolys.map(p => {
            const coords = p.points.map(pt => `${pt.lon} ${pt.lat}`);
            if (coords[0] !== coords[coords.length-1]) coords.push(coords[0]); 
            return {
                course_id: courseId,
                type: p.type,
                geom: `POLYGON((${coords.join(',')}))`
            };
        });
        
        if (featureRows.length > 0) await supabase.from('course_features').insert(featureRows);
        console.log("Course Saved Successfully!");
    }

    // --- WEATHER LOGIC (Open-Meteo) ---
    async function fetchWeather(lat, lon, greenLat = null, greenLon = null) {
        if (!window.state.isLoggedIn) return; // Only fetch if logged in
        
        try {
            // Base URL for single point (User)
            let url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,wind_speed_10m,wind_direction_10m&temperature_unit=fahrenheit&wind_speed_unit=mph`;
            
            // If green coords are provided, fetch both points in one call
            if (greenLat !== null && greenLon !== null) {
                    url = `https://api.open-meteo.com/v1/forecast?latitude=${lat},${greenLat}&longitude=${lon},${greenLon}&current=temperature_2m,wind_speed_10m,wind_direction_10m&temperature_unit=fahrenheit&wind_speed_unit=mph`;
            }

            const res = await fetch(url);
            if (!res.ok) throw new Error("Weather API Error");
            
            const data = await res.json();
            
            // DATA PARSING
            let userWeather, greenElev = null;

            if (Array.isArray(data)) {
                // Index 0 = User, Index 1 = Green
                const userData = data[0];
                const greenData = data[1];
                
                userWeather = {
                    temp: Math.round(userData.current.temperature_2m),
                    windSpeed: Math.round(userData.current.wind_speed_10m),
                    windDir: userData.current.wind_direction_10m,
                    elevation: userData.elevation || 0
                };
                greenElev = greenData.elevation || 0;
                
            } else {
                // Single point response
                userWeather = {
                    temp: Math.round(data.current.temperature_2m),
                    windSpeed: Math.round(data.current.wind_speed_10m),
                    windDir: data.current.wind_direction_10m,
                    elevation: data.elevation || 0
                };
            }
            
            window.state.weather = userWeather;
            if (greenElev !== null) window.state.greenElevation = greenElev;
            
            updateUI();
            
        } catch (e) {
            console.error("Weather fetch failed:", e);
        }
    }
    
