async function checkSupabaseForCourses(lat, lon) {
        // 1. Call the RPC function we just created
        const { data: dbCourses, error } = await supabase.rpc('nearby_courses', { 
            user_lat: lat, 
            user_lon: lon,
            radius_meters: 5000 // 5km search radius
        });

        if (error) {
            console.error("DB Search Error:", error);
            // On error, fall back to OSM immediately
            fetchOverpassData(lat, lon, 32200);
            return;
        }

        // 2. Logic: Found in DB? Show them. If not, go to OSM.
        if (dbCourses && dbCourses.length > 0) {
            console.log("Found courses in Supabase:", dbCourses);
            
            // Format DB results to match the App's expected structure
            window.state.courses = dbCourses.map(c => ({
                id: c.id,          // UUID
                name: c.name,
                osm_id: c.osm_id,
                dist: c.dist_meters, // calculated by PostGIS
                source: 'supabase',  // FLAG: Tells us this is a saved course
                holes: [],           // Empty for now, we load them on click
                availableTees: []
            }));

            renderCourseList();
            resetScanBtn();
            document.getElementById('scan-status').textContent = "Found in Database";
            
            // Switch UI to list view
            document.getElementById('finder-compact').classList.add('hidden');
            document.getElementById('finder-expanded').classList.remove('hidden');
            document.getElementById('course-list-container').classList.remove('hidden');

        } else {
            console.log("No courses in DB, checking OSM...");
            document.getElementById('scan-text').textContent = "Scanning OSM...";
            // Fallback to original OSM scan
            fetchOverpassData(lat, lon, 32200);
        }
    }

async function loadSupabaseCourseDetail(courseId) {
        const status = document.getElementById('scan-status');
        status.textContent = "Loading Map...";
        
        // 1. Fetch Holes
        const { data: holes } = await supabase
            .from('holes')
            .select('*')
            .eq('course_id', courseId)
            .order('hole_number', { ascending: true });

        // 2. Fetch Features (Polygons)
        const { data: features } = await supabase
            .from('course_features')
            .select('*')
            .eq('course_id', courseId);

        if (!holes || holes.length === 0) {
            alert("Error: Course found but has no hole data.");
            return false;
        }

        // 3. Update State
        // We need to map the DB format back to the App format
        const course = window.state.courses.find(c => c.id === courseId);
        
        // Map Holes
        course.holes = holes.map(h => ({
            label: `Hole ${h.hole_number}`,
            sortRef: h.hole_number,
            pars: { default: h.par },
            lat: h.green_center.coordinates[1], // PostGIS returns [lon, lat]
            lon: h.green_center.coordinates[0],
            teeLocation: h.tee_box ? { lat: h.tee_box.coordinates[1], lon: h.tee_box.coordinates[0] } : null
        }));

        // Map Polygons
        window.state.polygons = features.map(f => ({
            type: f.type,
            // PostGIS Polygon format is complex, we need to parse the coordinates
            // This assumes the standard GeoJSON structure returned by Supabase
            points: f.geom.coordinates[0].map(pt => ({ lat: pt[1], lon: pt[0] }))
        }));

        console.log("Course Loaded from DB!");
        return true;
    }

