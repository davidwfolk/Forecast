                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-1 overflow-hidden">
                            <div id="pro-bar" class="bg-slate-300 h-1 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
            </div>
                    <!-- Footer -->
        <div class="bg-slate-50 p-2 text-center border-t border-slate-100 shrink-0">
            <p class="text-[9px] text-slate-400">Data powered by OSM & PGA Tour Baselines | Weather data by Open-Meteo.com</p>
        </div>
    </div>
            <!-- Score Summary (shows after entry) -->
            <div id="score-summary" class="hidden mt-2 p-3 bg-white rounded-lg border border-blue-200">
                <div class="flex justify-between items-center">
                <div>
                    <p class="text-xs text-slate-500">Hole <span id="summary-hole-num">7</span></p>
                    <p class="font-bold text-slate-800"><span id="summary-score">4</span> strokes</p>
                </div>
                <button onclick="openScoreModal()" class="text-xs text-blue-600 hover:underline">Edit</button>
                </div>
            </div>
            </div>

        </div>

<!-- SCORE ENTRY MODAL -->
<div id="score-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-900/60 backdrop-blur-sm animate-fade-in">
  <div class="bg-white w-full sm:max-w-md rounded-t-2xl sm:rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-85vh">
    
