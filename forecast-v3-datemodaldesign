                            <button id="reset-dist-btn" class="hidden text-[9px] text-golf-600 font-bold uppercase hover:underline transition-all" onclick="resetDistance()">
                                Reset GPS
                            </button>
                            <span class="font-mono bg-golf-600 text-white px-1.5 py-0.5 rounded text-[10px] font-bold shadow-sm"><span id="dist-val">150</span> yds</span>
                        </div>
                    </div>
                    <input type="range" id="dist-input" min="50" max="300" value="150" step="1">
                    <div class="flex justify-between text-[9px] text-slate-400 mt-0.5 font-medium px-1">
                        <span>50y</span>
                        <span>300y</span>
                    </div>
                </div>
            </div>

            <!-- 4. LIE SELECTION -->
            <div>
                <div class="flex justify-between items-center mb-2">
                    <div class="flex items-center gap-2">
                        <label class="font-display font-bold text-slate-700 text-xs">Lie Condition</label>
                        <button id="reset-lie-btn" class="hidden text-[9px] text-golf-600 font-bold uppercase hover:underline transition-all" onclick="resetLie()">
                            Reset Auto
                        </button>
                    </div>
                    <span id="auto-lie-badge" class="hidden text-[9px] bg-blue-50 text-blue-600 border border-blue-100 px-2 py-0.5 rounded-full font-bold uppercase tracking-wide">Auto-Detected</span>
                </div>
                
                <div class="grid grid-cols-4 gap-2 bg-slate-100 p-1 rounded-xl">
