                            <button onclick="searchByZip()" id="zip-btn" class="bg-slate-700 hover:bg-slate-600 text-white font-medium px-3 py-1.5 rounded-lg text-xs transition-all-200">Search</button>
                        </div>
                    </div>

                    <!-- NEW: Course List Container (Replaces Dropdown) -->
                    <div id="course-list-container" class="hidden mt-4 space-y-2 animate-fade-in">
                        <label class="text-[9px] font-bold text-slate-400 uppercase tracking-wider pl-1">Select Course</label>
                        <div id="course-list" class="space-y-2 max-h-[240px] overflow-y-auto pr-1">
                            <!-- Tap-to-select cards injected here -->
                        </div>
                        
                        <!-- Mini Footer Info -->
                        <div class="flex justify-between items-center px-1 pt-1 border-t border-slate-100 mt-2">
                            <span class="text-[9px] text-golf-600 font-semibold bg-golf-50 px-2 py-0.5 rounded-md">Auto-Lie Active</span>
                            <span id="gps-accuracy" class="text-[9px] text-slate-400 font-mono">GPS: --</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. NEW HOLE INFO CARD (Compact) -->
                        <div id="hole-info-card" class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl p-3 text-white shadow-lg relative overflow-hidden hidden animate-fade-in">
                <div class="absolute top-0 right-0 w-24 h-24 bg-white/5 rounded-full -mr-8 -mt-8 blur-xl"></div>
                
                <!-- Row 1: Nav & Par -->
                <div class="flex justify-between items-center relative z-10 mb-2">
                    <!-- Left Arrow -->
                    <button onclick="changeHole(-1)" class="p-1.5 bg-white/10 hover:bg-white/20 rounded-full transition-colors active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>

                    <!-- Hole & Par Display -->
                    <div class="text-center">
                        <h2 id="hole-display-num" class="text-lg font-display font-bold">Hole 1</h2>
                        <p id="hole-display-par" class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold">Par 4</p>
                    </div>

                    <!-- Right Arrow -->
                    <button onclick="changeHole(1)" class="p-1.5 bg-white/10 hover:bg-white/20 rounded-full transition-colors active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>

                <!-- Row 2: Big Yardage -->
                <div class="text-center relative z-10 border-t border-white/10 pt-2">
                    <div id="hole-display-yards" class="text-3xl font-display font-bold tracking-tight text-white">---</div>
                    <p class="text-[9px] text-slate-400 uppercase tracking-wider mt-0.5">Distance to Pin</p>
                </div>
            
                <!-- Row 3: Tiny Action Buttons (EXACT LIE BUTTON SIZE) -->
                <div class="relative z-10 mt-3 pt-3">
                <div class="grid grid-cols-4 gap-2 bg-white/5 p-1 rounded-xl">
