    async function fetchOverpassData(lat, lon, radius) {
        const query = `[out:json][timeout:45];(way["golf"="course"](around:${radius},${lat},${lon});relation["golf"="course"](around:${radius},${lat},${lon});way["leisure"="golf_course"](around:${radius},${lat},${lon});relation["leisure"="golf_course"](around:${radius},${lat},${lon});way["golf"="hole"](around:${radius},${lat},${lon});node["golf"="green"](around:${radius},${lat},${lon});way["golf"="green"](around:${radius},${lat},${lon});node["golf"="pin"](around:${radius},${lat},${lon});node["golf"="tee"](around:${radius},${lat},${lon});way["golf"~"fairway|bunker|tee|water_hazard|rough"](around:${radius},${lat},${lon});way["natural"="water"](around:${radius},${lat},${lon}););out geom;`;
        
        const endpoints = [
            "https://overpass-api.de/api/interpreter",
            "https://overpass.kumi.systems/api/interpreter",
            "https://maps.mail.ru/osm/tools/overpass/api/interpreter",
            "https://lz4.overpass-api.de/api/interpreter",
            "https://overpass.openstreetmap.ru/api/interpreter"
        ];

        let successData = null;

        for (const ep of endpoints) {
            try {
                console.log(`Trying map server: ${ep}`);
                const res = await fetch(`${ep}?data=${encodeURIComponent(query)}`);
                if(!res.ok) throw new Error(res.statusText);
                successData = await res.json();
                break;
            } catch(e){
                console.warn(`Failed to connect to ${ep}:`, e);
            }
        }

        if (successData) {
            try {
                processMapData(successData.elements);
            } catch(e) {
                console.error("CRITICAL APP ERROR: Data received, but processing failed.", e);
                alert("App Error: Found map data but could not display it. Check console.");
                resetScanBtn();
            }
        } else {
            alert("Could not connect to map server. All mirrors failed. Please try again in a minute.");
            resetScanBtn();
        }
    }

    function processMapData(elements) {
        if (!elements || elements.length === 0) { alert("No courses found."); resetScanBtn(); return; }
        
        window.state.courses = []; window.state.polygons = [];
        let rawCourses = [], rawGreens = [], holeLines = [], rawTees = [];

        elements.forEach(el => {
            let lat, lon;
            if (el.type === 'node') { lat = el.lat; lon = el.lon; }
            else if (el.bounds) { lat = (el.bounds.minlat+el.bounds.maxlat)/2; lon = (el.bounds.minlon+el.bounds.maxlon)/2; }
            else if (el.geometry) { lat = el.geometry[0].lat; lon = el.geometry[0].lon; }
            else return;

            // Polygons
            if (el.type === 'way' && el.geometry && el.tags) {
                const pts = el.geometry.map(p=>({lat:p.lat, lon:p.lon}));
                let t = null;
                if(el.tags.golf==='fairway') t='fairway';
                else if(el.tags.golf==='bunker') t='bunker';
                else if(el.tags.golf==='tee') t='tee';
                else if(el.tags.golf==='water_hazard' || el.tags.natural==='water') t='water';
                else if(el.tags.golf==='rough') t='rough';
                if(t) window.state.polygons.push({type:t, points:pts});
            }

            // Courses
            const isCourse = (el.tags && (el.tags.golf==='course' || el.tags.leisure==='golf_course'));
            if(isCourse && el.tags.name) {
                rawCourses.push({ id:el.id, name:el.tags.name, lat, lon, dist: calcDist(window.state.userLat,window.state.userLon,lat,lon), holes:[], availableTees: [] });
            }
            
            // Greens
            else if (el.tags && (el.tags.golf==='green'||el.tags.golf==='pin')) {
                let lbl="Green", ref=null;
                if(el.tags.ref){ lbl=`Hole ${el.tags.ref}`; ref=parseInt(el.tags.ref); }
                else if(el.tags.name){ 
                    if(/^\d+$/.test(el.tags.name)){ lbl=`Hole ${el.tags.name}`; ref=parseInt(el.tags.name); }
                    else lbl=el.tags.name;
                }
                rawGreens.push({ label:lbl, sortRef:ref, lat, lon, pars: { default: '-' }, teeLocation: null });
            }

            // Explicit Tee Nodes
            else if (el.tags && el.tags.golf==='tee') {
                let ref = null;
                if(el.tags.ref) ref = parseInt(el.tags.ref);
                rawTees.push({ ref: ref, lat, lon });
            }

            // Hole Lines
            else if (el.tags && el.tags.golf==='hole' && el.tags.ref && el.geometry) {
                const start = el.geometry[0];
                const end = el.geometry[el.geometry.length-1];
                const pars = { default: el.tags.par || el.tags['golf:par'] || '-' };
                Object.keys(el.tags).forEach(key => {
                    if (key.startsWith('par:')) {
                        const color = key.split(':')[1];
                        pars[color] = el.tags[key];
                    }
                });
                holeLines.push({ ref:parseInt(el.tags.ref), endLat:end.lat, endLon:end.lon, startLat:start.lat, startLon:start.lon, pars: pars });
            }
        });

        // Match Lines to Greens
        rawGreens.forEach(g => {
            let best=null, minD=40;
            holeLines.forEach(l => {
                const d = calcDist(g.lat, g.lon, l.endLat, l.endLon);
                if(d<minD){ minD=d; best=l; }
            });
            
            if(best){ 
                g.pars = best.pars; 
                if(g.sortRef === null) { g.sortRef = best.ref; g.label=`Hole ${best.ref}`; }
                g.teeLocation = { lat: best.startLat, lon: best.startLon };
            }
        });

        // Associate Explicit Tee Nodes
        rawGreens.forEach(g => {
            if(g.sortRef !== null) {
                let bestTee = null;
                let minTeeDist = 1000;
                rawTees.forEach(t => {
                    if(t.ref === g.sortRef) {
                        const d = calcDist(g.lat, g.lon, t.lat, t.lon);
                        if(d < minTeeDist) { minTeeDist = d; bestTee = t; }
                    }
                });
                if(bestTee) g.teeLocation = { lat: bestTee.lat, lon: bestTee.lon };
            }
        });

        if(rawCourses.length===0) rawCourses.push({name:"Unknown Course", lat:window.state.userLat, lon:window.state.userLon, dist:0, holes:[], availableTees: []});

        // Assign Greens to Course
        rawGreens.forEach(g => {
            let best=null, minD=Infinity;
            rawCourses.forEach(c => {
                const d = calcDist(c.lat,c.lon, g.lat,g.lon);
                if(d<minD){ minD=d; best=c; }
            });
            if(best){
                g.userDist = calcDist(window.state.userLat, window.state.userLon, g.lat, g.lon);
                best.holes.push(g);
            }
        });

        // Clean & Sort
        rawCourses.forEach(c => {
            const hasNums = c.holes.some(h=>h.sortRef!==null);
            if(hasNums) c.holes = c.holes.filter(h=>h.sortRef!==null || (h.label!=="Green" && !h.label.includes("Practice")));
            c.holes.sort((a,b)=>(a.sortRef||999)-(b.sortRef||999));
            
            const teeSet = new Set();
            c.holes.forEach(h => { Object.keys(h.pars).forEach(k => { if(k !== 'default') teeSet.add(k); }); });
            c.availableTees = Array.from(teeSet);
        });


        window.state.courses = rawCourses.filter(c=>c.holes.length>0).sort((a,b)=>a.dist-b.dist);
        
        // --- ADD THIS TRIGGER RIGHT HERE ---
        if (window.state.courses.length > 0) {
             // Save the closest course (index 0) along with the polygons
             saveCourseToSupabase(window.state.courses[0], window.state.polygons);
        }

        renderCourseList();
        
        const legacySel = document.getElementById('hole-selection-container');
        const newSel = document.getElementById('course-list-container');
        if(legacySel) legacySel.classList.add('hidden');
        if(newSel) newSel.classList.remove('hidden');
        
        resetScanBtn();
        checkAutoLie(window.state.userLat, window.state.userLon);
    }

    // --- AUTO-ADVANCE LOGIC ---
    function checkAutoHoleSwitch(lat, lon) {
        if (window.state.selectedCourseIndex === null) return;
        const course = window.state.courses[window.state.selectedCourseIndex];
        
        for (let i = 0; i < course.holes.length; i++) {
            const hole = course.holes[i];
            if (hole.teeLocation) {
                const distToTee = calcDist(lat, lon, hole.teeLocation.lat, hole.teeLocation.lon);
                if (distToTee < 15 && window.state.currentHoleIndex !== i) {
                    window.state.currentHoleIndex = i;
                    window.state.manualDistance = false;
                    document.getElementById('reset-dist-btn').classList.add('hidden');
                    
                    if(window.state.isLoggedIn) {
                        fetchWeather(lat, lon, hole.lat, hole.lon);
                    }
                    
                    updateHoleDisplay();
                    break; 
                }
            }
        }
    }

    function checkAutoLie(lat, lon) {
        if(window.state.polygons.length===0) return;
        let lie = null;
        window.state.isOnTee = false;

        if(inPoly(lat,lon,'water')) lie='recovery';
        else if(inPoly(lat,lon,'bunker')) lie='bunker';
        else if(inPoly(lat,lon,'tee')) {
            lie='fairway';
            window.state.isOnTee = true;
        }
        else if(inPoly(lat,lon,'fairway')) lie='fairway';
        else if(inPoly(lat,lon,'rough')) lie='rough';
        
        if(lie) window.setLie(lie, true);
    }

    function inPoly(lat, lon, type) {
        const targets = window.state.polygons.filter(p=>p.type===type);
        for(let t of targets) {
            let inside=false;
            for(let i=0,j=t.points.length-1; i<t.points.length; j=i++){
                let xi=t.points[i].lat, yi=t.points[i].lon;
                let xj=t.points[j].lat, yj=t.points[j].lon;
                let intersect = ((yi>lon)!==(yj>lon)) && (lat<(xj-xi)*(lon-yi)/(yj-yi)+xi);
                if(intersect) inside=!inside;
            }
            if(inside) return true;
        }
        return false;
    }

    // Utils
    function formatDist(y) { return y>700 ? (y/1760).toFixed(1)+" mi" : Math.round(y)+"y"; }
    function calcDist(lat1,lon1,lat2,lon2) {
        const R=6371e3, φ1=lat1*Math.PI/180, φ2=lat2*Math.PI/180, Δφ=(lat2-lat1)*Math.PI/180, Δλ=(lon2-lon1)*Math.PI/180;
        const a=Math.sin(Δφ/2)**2 + Math.cos(φ1)*Math.cos(φ2)*Math.sin(Δλ/2)**2;
        return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))*1.09361;
    }
    function interpolate(x, t) {
        const ks = Object.keys(t).map(Number).sort((a,b)=>a-b);
        if(x<=ks[0]) return t[ks[0]];
        if(x>=ks[ks.length-1]) return t[ks[ks.length-1]];
        for(let i=0; i<ks.length-1; i++){
            if(x>=ks[i] && x<=ks[i+1]){
                let r=(x-ks[i])/(ks[i+1]-ks[i]);
                return t[ks[i]]+(t[ks[i+1]]-t[ks[i]])*r;
            }
        }
        return 0;
    }

