                        </div>
                    </div>
                    <button class="text-[10px] font-semibold text-golf-600 bg-white px-3 py-1.5 rounded-lg border border-slate-100 shadow-sm hover:bg-slate-50 transition-colors">Change</button>
                </div>

                <!-- EXPANDED VIEW -->
