                </div>

                <!-- MOVED DOWN: Analysis Card -->
                <div class="w-full space-y-3">
                    <!-- Pro Comparison -->
                    <div class="space-y-1">
                        <div class="flex justify-between items-end text-[10px] px-1">
                            <span class="text-slate-500 font-medium">Tour Pro Baseline</span>
