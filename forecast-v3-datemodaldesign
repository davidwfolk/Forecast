    window.changeHole = function(offset) {
        if(window.state.selectedCourseIndex === null) return;
        const course = window.state.courses[window.state.selectedCourseIndex];
        
        let newIndex = window.state.currentHoleIndex + offset;
        
        if(newIndex < 0) newIndex = course.holes.length - 1;
        if(newIndex >= course.holes.length) newIndex = 0;
        
        window.state.currentHoleIndex = newIndex;
        window.state.manualDistance = false;
        document.getElementById('reset-dist-btn').classList.add('hidden');
        updateHoleDisplay();
    }

    function updateHoleDisplay() {
        if(window.state.selectedCourseIndex === null) return;
        const course = window.state.courses[window.state.selectedCourseIndex];
        const hole = course.holes[window.state.currentHoleIndex];
        
        const parVal = hole.pars[window.state.selectedTee] || hole.pars['default'];
        
        document.getElementById('hole-display-num').textContent = hole.label;
        document.getElementById('hole-display-par').textContent = parVal !== '-' ? `Par ${parVal}` : 'Par --';
        
        if(!window.state.manualDistance) {
            const dist = calcDist(window.state.userLat, window.state.userLon, hole.lat, hole.lon);
            window.state.dist = Math.round(dist);
        }
        
        let distText = Math.round(window.state.dist) + " Yards";
        if(window.state.dist > 700) distText = (window.state.dist/1760).toFixed(2) + " Miles";
        document.getElementById('hole-display-yards').textContent = distText;

        document.getElementById('dist-input').value = window.state.dist;
        document.getElementById('dist-val').textContent = window.state.dist;
        
        updateUI();
        // Show score entry section
        showScoreSection();

    }

    window.resetDistance = function() {
        window.state.manualDistance = false;
        document.getElementById('reset-dist-btn').classList.add('hidden');
        updateHoleDisplay();
    }

    window.setLie = function(l, auto) {
        if (auto && window.state.manualLie) return;

        window.state.lie = l;
        if (!auto) {
            window.state.manualLie = true;
            document.getElementById('reset-lie-btn').classList.remove('hidden');
            document.getElementById('auto-lie-badge').classList.add('hidden');
        } else {
            document.getElementById('auto-lie-badge').classList.remove('hidden');
            document.getElementById('auto-lie-badge').textContent = `Auto: ${l.toUpperCase()}`;
        }
        updateLieButtons();
        updateUI();
    }

    window.resetLie = function() {
        window.state.manualLie = false;
        document.getElementById('reset-lie-btn').classList.add('hidden');
        checkAutoLie(window.state.userLat, window.state.userLon);
    }
    
    // --- PLAY LIKE & CLUB RECOMMENDATION ---
    
    function calculatePlaysLike(dist, lie) {
        let multiplier = 1.0;
        if (lie === 'rough') multiplier = 1.10;
        if (lie === 'bunker') multiplier = 1.20;
        return Math.round(dist * multiplier);
    }
    
    function getClubRecommendation(playsLikeDist) {
        let bag = clubList.map(c => {
            const userDist = window.state.clubs[c.id];
            const dist = userDist !== undefined ? userDist : c.default;
            const typeName = window.state.clubTypes[c.id] || c.name;
            return { name: typeName, dist: dist, id: c.id };
        });

        if (!window.state.isOnTee) {
            bag = bag.filter(c => c.id !== 'driver');
        }

        bag.sort((a, b) => b.dist - a.dist); 

        let recommended = bag[0]; 
        
        for (let i = bag.length - 1; i >= 0; i--) {
            if (bag[i].dist >= playsLikeDist) {
                recommended = bag[i];
                break;
            }
        }
        
        let pct = (playsLikeDist / recommended.dist) * 100;
        pct = Math.round(pct / 5) * 5;
        
        if (pct > 100) pct = 100; 
        if (pct < 40) pct = 40; 
        
        return { club: recommended.name, pct: pct };
    }
    
    function calculateShotPhysics(dist) {
            const weather = window.state.weather;
            let lieAdj = 0, tempAdj = 0, windAdj = 0, elevAdj = 0, slopeAdj = 0;

            if (window.state.lie === 'rough') lieAdj = dist * 0.07; 
            else if (window.state.lie === 'bunker') lieAdj = dist * 0.15; 

            if (weather) {
                tempAdj = -(dist * ((weather.temp - 85) * 0.001));

                const elevMeters = weather.elevation || 0;
                elevAdj = -(dist * (((elevMeters * 3.28084) / 1000) * 0.012));

// SLOPE: REVISED CADDIE LOGIC
                 if (window.state.greenElevation !== null) {
                     const diffMeters = window.state.greenElevation - elevMeters;
                     const diffFeet = diffMeters * 3.28084;

                     // Base formula: 1 yard per 3 feet elevation change (Standard Rule)
                     let baseAdj = diffFeet / 3;

                     // Asymmetry: Downhill helps less than uphill hurts (Trajectory physics)
                     const asymmetryFactor = diffFeet > 0 ? 1.0 : 0.6;

                     slopeAdj = baseAdj * asymmetryFactor;

                     // Sanity check: cap at ±20% of distance
                     slopeAdj = Math.max(-dist * 0.2, Math.min(dist * 0.2, slopeAdj));
                 }

                if (window.state.selectedCourseIndex !== null) {
                    const course = window.state.courses[window.state.selectedCourseIndex];
                    const hole = course.holes[window.state.currentHoleIndex];
                    
                    const bearing = getBearing(window.state.userLat, window.state.userLon, hole.lat, hole.lon);
                    const theta = Math.abs(bearing - weather.windDir) * (Math.PI/180);
                    const windFactor = Math.cos(theta); 
                    
                    let windMod = weather.windSpeed * windFactor;
                    if (windMod < 0) windMod *= 0.5;
                    windAdj = dist * (windMod * 0.01);
                }
            }

            const totalPlaysLike = Math.round(dist + lieAdj + tempAdj + windAdj + elevAdj + slopeAdj);
            
            return {
                total: totalPlaysLike,
                adjustments: { lie: lieAdj, temp: tempAdj, wind: windAdj, elev: elevAdj, slope: slopeAdj }
            };
    }

    function calculate(distanceOverride) {
        const effectiveDist = distanceOverride !== undefined ? distanceOverride : window.state.dist;
        
        const table = baselines[window.state.lie] || baselines.fairway;
        const base = interpolate(effectiveDist, table);
        const hcp = window.state.hcp;
        const delta = hcp + 5;
        const dFact = effectiveDist<100 ? 0.6 : effectiveDist>175 ? 1.3 : 1.0;
        
        let prob = Math.min(99, Math.max(1, base - (delta*1.2*dFact)));
        
        return { user:prob.toFixed(1), pro:base.toFixed(1) };
    }

    function updateUI() {
        let res;
        let physics = null;

        if (window.state.isLoggedIn && window.state.lie !== 'recovery') {
            const dist = parseFloat(window.state.dist);
            physics = calculateShotPhysics(dist);
            res = calculate(physics.total - physics.adjustments.lie);
        } else {
            res = calculate(window.state.dist);
        }

        document.getElementById('prob-display').textContent = Math.round(res.user)+"%";
        document.getElementById('pro-val').textContent = Math.round(res.pro)+"%";
        document.getElementById('prob-circle').style.setProperty('--progress', `${res.user}%`);
        document.getElementById('pro-bar').style.width = `${res.pro}%`;
        
        const weatherWidget = document.getElementById('weather-widget');
        if (window.state.isLoggedIn && window.state.weather) {
            weatherWidget.classList.remove('hidden');
            document.getElementById('weather-temp').textContent = `${window.state.weather.temp}°F`;
            document.getElementById('weather-wind').textContent = `${window.state.weather.windSpeed} mph`;
            const elevFt = Math.round(window.state.weather.elevation * 3.28084);
            if(document.getElementById('weather-elev')) {
                    document.getElementById('weather-elev').textContent = `${elevFt} ft`;
            }
            
            document.getElementById('wind-arrow-icon').style.transform = `rotate(${window.state.weather.windDir}deg)`;
        } else {
            weatherWidget.classList.add('hidden');
        }

        const analysisContainer = document.getElementById('analysis-text');
        const u = parseFloat(res.user);
        const circ = document.getElementById('prob-circle');
        let color = '#16a34a';

        if(window.state.lie==='recovery') color='#ef4444'; 
        else if(u > parseFloat(res.pro)+5) color='#16a34a'; 
        else if(u > 65) color='#16a34a'; 
        else if(u > 45) color='#eab308'; 
        else if(u > 25) color='#f97316'; 
        else color='#ef4444';
        
        circ.style.setProperty('--bar-color', color);

        if (!window.state.isLoggedIn) {
            analysisContainer.innerHTML = `<div class="p-4 w-full h-full flex items-center justify-center"><p class="text-xs text-slate-600 font-medium leading-relaxed text-center" id="guest-advice-text"></p></div>`;
            
            const el = document.getElementById('guest-advice-text');
            
            if(window.state.lie==='recovery') { 
                el.textContent="Recovery Mode. Get back to safety."; 
            }
            else if(u > parseFloat(res.pro)+5) { 
                el.textContent="Elite. You beat the pros here."; 
            }
            else if(u > 65) { 
                el.textContent="Green Light! Go flag hunting."; 
            }
            else if(u > 45) { 
                el.textContent="Good odds. Aim center mass."; 
            }
            else if(u > 25) { 
                el.textContent="Defensive Zone. Play safe."; 
            }
            else { 
                el.textContent="High Risk. Avoid trouble."; 
            }
            return; 
        }
        
        if (window.state.lie === 'recovery') {
            analysisContainer.innerHTML = `
                <div class="p-4 w-full h-full flex flex-col items-center justify-center">
                    <span class="font-bold text-red-600 block text-lg">RECOVERY</span>
                    <span class="text-xs text-slate-500">Punch out to fairway.</span>
                </div>`;
        } else {
            const totalPlaysLike = physics.total;
            const rec = getClubRecommendation(totalPlaysLike);
            
            const { lie: lieAdj, temp: tempAdj, wind: windAdj, elev: elevAdj, slope: slopeAdj } = physics.adjustments;
            const fmt = (n) => (n > 0 ? `+${Math.round(n)}` : `${Math.round(n)}`);

            analysisContainer.innerHTML = `
                <div class="w-full flex flex-col divide-y divide-slate-100">
                    <div class="px-3 py-1.5 bg-slate-50 flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Conditions</span>
                            <button onclick="forceWeatherUpdate(this)" class="p-1 hover:bg-slate-200 rounded-full transition-colors" title="Force Weather/Slope Update">
                                <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            </button>
                        </div>
                        <span class="text-[9px] font-bold text-slate-300">IMPACT (YDS)</span>
                    </div>
                    
                    <div class="grid grid-cols-5 px-1 py-1.5 bg-slate-50 text-center border-t border-slate-100">
                        <span class="text-[8px] font-bold text-slate-400 uppercase tracking-widest">Lie</span>
                        <span class="text-[8px] font-bold text-slate-400 uppercase tracking-widest">Temp</span>
                        <span class="text-[8px] font-bold text-slate-400 uppercase tracking-widest">Wind</span>
                        <span class="text-[8px] font-bold text-slate-400 uppercase tracking-widest">Elev</span>
                        <span class="text-[8px] font-bold text-slate-400 uppercase tracking-widest">Slope</span>
                    </div>

                    <div class="grid grid-cols-5 divide-x divide-slate-100 bg-white text-center">
                        <div class="py-2 text-xs font-bold ${lieAdj > 0 ? 'text-red-500' : 'text-slate-400'}">${fmt(lieAdj)}</div>
                        <div class="py-2 text-xs font-bold ${tempAdj !== 0 ? 'text-blue-500' : 'text-slate-400'}">${fmt(tempAdj)}</div>
                        <div class="py-2 text-xs font-bold ${Math.abs(windAdj) > 2 ? 'text-blue-500' : 'text-slate-400'}">${fmt(windAdj)}</div>
                        <div class="py-2 text-xs font-bold ${elevAdj !== 0 ? 'text-blue-500' : 'text-slate-400'}">${fmt(elevAdj)}</div>
                        <div class="py-2 text-xs font-bold ${slopeAdj !== 0 ? 'text-blue-500' : 'text-slate-400'}">${fmt(slopeAdj)}</div>
                    </div>

                    <div class="flex justify-between items-center w-full px-4 py-3 bg-slate-50/50 border-t border-slate-100">
                        <div class="text-center flex-1">
                            <span class="block text-[9px] text-slate-400 uppercase tracking-wider mb-0.5">Plays Like</span>
                            <span class="block text-xl font-bold text-slate-800">${totalPlaysLike}y</span>
                        </div>
                        <div class="h-8 w-px bg-slate-200 mx-4"></div>
                        <div class="text-center flex-1">
                            <span class="block text-[9px] text-slate-400 uppercase tracking-wider mb-0.5">Caddie Suggests</span>
                            <span class="block text-xl font-bold text-golf-600 leading-none">${rec.pct}% <span class="text-slate-700 text-base">${rec.club}</span></span>
                        </div>
                    </div>
                </div>
            `;
        }
    }

    // Listeners
    document.getElementById('hcp-input').addEventListener('input', e=>{
        window.state.hcp=parseInt(e.target.value);
        saveUserSetting('handicap', window.state.hcp);
        document.getElementById('hcp-val').textContent = window.state.hcp<0 ? "+"+Math.abs(window.state.hcp) : window.state.hcp;
        updateUI();
    });
    document.getElementById('dist-input').addEventListener('input', e=>{
        window.state.dist=e.target.value;
        window.state.manualDistance = true;
        document.getElementById('reset-dist-btn').classList.remove('hidden');
        document.getElementById('dist-val').textContent=window.state.dist;
        updateUI();
    });

    // Init
    updateLieButtons();
    updateUI();
</script>
