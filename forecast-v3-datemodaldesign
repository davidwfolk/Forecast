                            data-lie="fairway" onclick="setLie('fairway', false)">
                        Fairway
                    </button>
                    <button class="lie-btn relative rounded-lg py-1.5 text-[9px] font-bold uppercase tracking-wide transition-all-200 hover:text-golf-700 focus:outline-none" 
                            data-lie="rough" onclick="setLie('rough', false)">
                        Rough
                    </button>
                    <button class="lie-btn relative rounded-lg py-1.5 text-[9px] font-bold uppercase tracking-wide transition-all-200 hover:text-golf-700 focus:outline-none" 
                            data-lie="bunker" onclick="setLie('bunker', false)">
                        Bunker
                    </button>
                    <button class="lie-btn relative rounded-lg py-1.5 text-[9px] font-bold uppercase tracking-wide transition-all-200 hover:text-golf-700 focus:outline-none" 
                            data-lie="recovery" onclick="setLie('recovery', false)">
                        Recov
                    </button>
                </div>
            </div>

            <!-- 5. RESULTS DASHBOARD -->
