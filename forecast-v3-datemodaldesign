                    Exit
                    </button>
                </div>
                </div>


            </div>

            <!-- 3. HANDICAP & DISTANCE SLIDERS -->
            <div class="grid grid-cols-1 gap-4">
                <!-- Handicap (Wrapper for Guest Mode) -->
                <div id="dashboard-hcp-wrapper">
                    <!-- This entire block moves to the modal when logged in -->
                    <div id="hcp-component">
                        <div class="flex justify-between mb-1.5">
