                            </button>
                        </div>
                    </div>
                    
                    <!-- Primary Action -->
                    <button onclick="scanForCourses()" id="scan-btn" class="w-full bg-golf-600 hover:bg-golf-500 text-white font-medium py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 transition-all-200 shadow-md shadow-green-900/10 active:scale-[0.98] text-sm">
                        <span id="scan-icon" class="text-lg">📍</span> 
                        <span id="scan-text">Scan Nearby</span>
                    </button>

                    <!-- Clean Zip Search Toggle -->
                    <div class="text-center mt-3">
                        <button onclick="toggleZipSearch()" id="zip-toggle-btn" class="text-[10px] text-slate-400 font-bold uppercase tracking-wider hover:text-golf-600 transition-colors underline">
                            Not at the course? Search by Zip
