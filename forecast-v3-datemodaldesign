// Update scorecard table
async function updateScorecard() {
  if (!window.state.currentRoundId) return;
  
  const course = window.state.courses[window.state.selectedCourseIndex];
  const tbody = document.getElementById('scorecard-body');
  tbody.innerHTML = '';
  
  // Fetch scores from database
  const { data: scores } = await supabase
    .from('hole_scores')
    .select('hole_number, total_strokes')
    .eq('round_id', window.state.currentRoundId)
    .order('hole_number');
  
  const scoresMap = {};
  scores?.forEach(s => scoresMap[s.hole_number] = s.total_strokes);
  
  let totalPar = 0;
  let totalScore = 0;
  
  // Build rows
  course.holes.forEach((hole, idx) => {
    const holeNum = hole.sortRef || (idx + 1);
    const par = parseInt(hole.pars?.default || 4);
    const score = scoresMap[holeNum];
    const diff = score ? score - par : null;
    
    totalPar += par;
    if (score) totalScore += score;
    
    const row = document.createElement('tr');
    row.className = holeNum === (window.state.currentHoleIndex + 1) ? 'bg-blue-50' : '';
    row.innerHTML = `
      <td class="py-2 px-2 font-semibold text-slate-800">${holeNum}</td>
      <td class="text-center py-2 px-2 text-slate-600">${par}</td>
      <td class="text-center py-2 px-2 font-bold ${score ? 'text-blue-600' : 'text-slate-300'}">${score || '—'}</td>
      <td class="text-center py-2 px-2 font-semibold ${diff > 0 ? 'text-red-600' : diff < 0 ? 'text-green-600' : 'text-slate-400'}">${diff !== null ? (diff > 0 ? '+' + diff : diff) : '—'}</td>
    `;
    tbody.appendChild(row);
  });
  
  // Update totals
  document.getElementById('total-par').textContent = totalPar;
  document.getElementById('total-score').textContent = totalScore || '--';
  const totalDiff = totalScore ? totalScore - totalPar : null;
  const diffEl = document.getElementById('total-diff');
  diffEl.textContent = totalDiff !== null ? (totalDiff > 0 ? '+' + totalDiff : totalDiff) : '--';
  diffEl.className = `text-center py-3 px-2 font-bold ${totalDiff > 0 ? 'text-red-600' : totalDiff < 0 ? 'text-green-600' : 'text-slate-600'}`;
}


