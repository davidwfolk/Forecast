                        <div class="flex items-center gap-2">
                            <span id="scan-status" class="text-[10px] text-slate-400 font-medium">Ready</span>
                            <!-- Collapse Button (Hidden initially) -->
                            <button id="finder-collapse-btn" onclick="toggleFinder(false)" class="hidden text-slate-400 hover:text-slate-600 p-1">
