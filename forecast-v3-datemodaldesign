                    </div>
                </div>

                <!-- MOVED DOWN: Circular Gauge -->
                <div class="progress-circle mb-3" id="prob-circle">
                    <div class="progress-inner">
                        <span class="text-[9px] text-slate-400 font-bold uppercase tracking-widest mb-0.5">GIR %</span>
